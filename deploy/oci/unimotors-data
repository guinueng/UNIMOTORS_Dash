# /etc/nginx/sites-available/unimotors-data
# 팀 대시보드 (기숙사 Pi4 10.10.0.9:8090) — WebSocket
server {
    listen 443 ssl;
    server_name data.unimotors.example.com;
    include snippets/unimotors-ssl.conf;

    auth_basic "UNIMOTORS";
    auth_basic_user_file /etc/nginx/.htpasswd;

    location / {
        proxy_pass http://10.10.0.9:8090;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;      # WebSocket 필수
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }
}
server {
    listen 80;
    server_name data.unimotors.example.com;
    return 301 https://$host$request_uri;
}
