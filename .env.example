# UNIMOTORS 환경변수 — /etc/default/unimotors 로 복사해 쓴다.
#   sudo cp .env.example /etc/default/unimotors && sudo chmod 600 /etc/default/unimotors
# systemd 유닛들이 EnvironmentFile=-/etc/default/unimotors 로 읽는다.

# 차량 ↔ 서버 공유 인증 토큰. 양쪽이 반드시 같아야 한다.
UNIMOTORS_TOKEN=change-me

# 차량 프리셋: car1 | starex | car_personal2 | local_only
UNIMOTORS_PRESET=car1

# LTE (KT 기본값)
UNIMOTORS_APN=lte.ktfwing.com
UNIMOTORS_AT_PORT=/dev/ttyUSB2

# v7: 식별·복원. 배터리 교체/충전 또는 다른 사용 구간 시작 때 새 ID로 바꾼다.
# 비워두면 자동 복원 대신 정차 후 동일 배터리·경기 확인이 필요하다.
UNIMOTORS_BATTERY_EPOCH=
UNIMOTORS_RESUME_SECONDS=300
# RTC/시각 동기화가 실제 검증된 환경에만 1. 기본은 timesync 신호를 확인한다.
UNIMOTORS_TIME_TRUSTED=0
UNIMOTORS_LOG_DIR=/home/unimotors/gps_logs
UNIMOTORS_STATE_DIR=/home/unimotors/gps_logs/state
UNIMOTORS_PERSIST_SECONDS=1
UNIMOTORS_DISPLAY_RATE=0.1
UNIMOTORS_SAMPLE_RATE=0.2
UNIMOTORS_SSE_RATE=0.2
UNIMOTORS_SERVER_WS=ws://10.10.0.9:8090/ingest
UNIMOTORS_SERVER_HTTP=http://10.10.0.9:8090
